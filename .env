# путь до базы данных поменять на 127.0.0.1 при использовании на локальной машине
DB_URL = 192.168.3.52
# стандартный порт для постгры
DB_PORT = 5432
# название бд к которой конектишься
DB_NAME = db_farm
# имя для созданного пользователя в базе данных
DB_USER = user_farm
# пароль от бд, из прикольных идей создать из обыкновенного пароля прогнав через условный sha256
DB_PASS = root

# порт на котором будет работать сервер
SERVER_PORT = 3001
# порт на котором работает фронт сайтас
FRONTEND_PORT = 3000
